{
  "name": "ishak-env",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "python3 -m pip install --no-cache-dir -r requirements.txt",
  "postStartCommand": "bash /workspaces/e2b-mcp-server/bootstrap.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "visibility": "public",
      "onAutoForward": "ignore",
      "label": "MCP SSE"
    }
  },
  "remoteUser": "codespace",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
